[
 {
  "t0": 1.56,
  "t1": 4.62,
  "text": "我们都是渺小真实存在"
 },
 {
  "t0": 4.7,
  "t1": 7.96,
  "text": "祈愿小世界里不只有挫败"
 },
 {
  "t0": 8.32,
  "t1": 11.44,
  "text": "直到遇见你我以为就光明起来"
 },
 {
  "t0": 11.8,
  "t1": 14.82,
  "text": "眼睛里看到的都是广袤无垠的大海"
 },
 {
  "t0": 15.6,
  "t1": 18.66,
  "text": "有你在的日子不可能被取代"
 },
 {
  "t0": 19.02,
  "t1": 22.04,
  "text": "在最灰暗的日子你陪着我发呆"
 },
 {
  "t0": 22.52,
  "t1": 24.98,
  "text": "你让我学会如何拨开阴霾"
 },
 {
  "t0": 25.42,
  "t1": 28.0,
  "text": "将快乐全都收集将不开心全都淘汰"
 },
 {
  "t0": 28.98,
  "t1": 31.4,
  "text": "你对我说的情话"
 },
 {
  "t0": 31.5,
  "t1": 34.6,
  "text": "像转瞬即逝的烟花"
 },
 {
  "t0": 35.66,
  "t1": 38.3,
  "text": "只停在绽放一刹那"
 },
 {
  "t0": 38.46,
  "t1": 41.4,
  "text": "我却已无法自拔"
 },
 {
  "t0": 42.58,
  "t1": 44.6,
  "text": "我们的爱总有时差"
 },
 {
  "t0": 44.64,
  "t1": 48.1,
  "text": "也为你骗自己放下"
 },
 {
  "t0": 48.56,
  "t1": 53.2,
  "text": "爱炙热的你，却忘了爱自己"
 }
]